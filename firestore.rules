rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidLifeTask(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.completed is bool &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('priority' in data) || (data.priority in ['low', 'medium', 'high']));
    }

    function isValidChatSession(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('agentRole' in data) || (data.agentRole is string && data.agentRole.size() <= 100)) &&
        (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000));
    }

    function isValidChatMessage(data, userId, sessionId) {
      return data.userId == userId &&
        data.sessionId == sessionId &&
        data.sender in ['user', 'assistant', 'system'] &&
        data.content is string && data.content.size() <= 5000;
    }

    function isValidVaultItem(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('encryptedData' in data) || (data.encryptedData is string && data.encryptedData.size() <= 10000));
    }

    // User collection & subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(taskId) && isValidLifeTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(taskId) && isValidLifeTask(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'completed', 'category', 'priority', 'dueDate', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      }

      // Chat sessions subcollection
      match /chatSessions/{sessionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidChatSession(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidChatSession(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'agentRole', 'lastMessage', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);

        // Chat messages subcollection
        match /messages/{messageId} {
          allow get, list: if isOwner(userId) && isValidId(userId);
          allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && isValidChatMessage(incoming(), userId, sessionId);
          allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && isValidChatMessage(incoming(), userId, sessionId) &&
            incoming().userId == existing().userId &&
            incoming().sessionId == existing().sessionId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'timestamp']);
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidId(messageId);
        }
      }

      // Vault items subcollection
      match /vaultItems/{itemId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && isValidVaultItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && isValidVaultItem(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'encryptedData', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
      }
    }
  }
}
